# Kamal secrets configuration
# Copy this file to .kamal/secrets and fill in your values
# DO NOT commit .kamal/secrets to git - it should be in .gitignore

# Docker registry password (Docker Hub, GitHub Container Registry, etc.)
KAMAL_REGISTRY_PASSWORD=your-registry-password-here

# Rails master key (get from backend/config/master.key)
RAILS_MASTER_KEY=$(cat backend/config/master.key)

# Database configuration
DATABASE_URL=postgresql://postgres:your-postgres-password@trello-app-db:5432/trello_production
POSTGRES_PASSWORD=your-postgres-password-here

# Redis URL
REDIS_URL=redis://trello-app-redis:6379/0

# Rails secret key base (generate with: cd backend && bin/rails secret)
SECRET_KEY_BASE=your-secret-key-base-here

# Sentry DSN for error tracking (get from https://sentry.io)
SENTRY_DSN=your-backend-sentry-dsn-here
NEXT_PUBLIC_SENTRY_DSN=your-frontend-sentry-dsn-here

# PostHog API key for analytics (get from https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-api-key-here
